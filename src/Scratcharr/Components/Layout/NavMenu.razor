@implements IDisposable
@inject ScanService Scans
@inject ToolStatusService Tools
@inject JobQueue Queue
@inject Cleaner Cleaner

<nav class="sv-sidebar @(_collapsed ? "collapsed" : "") @(MobileOpen ? "sv-mobile-open" : "")">
    <div class="sv-sidebar-header d-none d-md-flex">
        <a href="" class="d-flex align-items-center gap-2 text-decoration-none">
            <img src="favicon.svg" alt="" class="sv-logo"/>
            <span class="text-light fw-semibold sv-logo-text">Scratcharr</span>
        </a>
    </div>

    <div class="sv-nav-content">
        <ul class="nav flex-column">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="Close">
                    <i class="bi bi-speedometer2"></i>
                    <span>Overview</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="items" @onclick="Close">
                    <i class="bi bi-folder2-open"></i>
                    <span>Downloads@(_review > 0 ? $" ({_review})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="unpack" @onclick="Close">
                    <i class="bi bi-file-earmark-zip"></i>
                    <span>Unpack@(_archives > 0 ? $" ({_archives})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="external" @onclick="Close">
                    <i class="bi bi-hdd-network"></i>
                    <span>External</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="jobs" @onclick="Close">
                    <i class="bi bi-list-task"></i>
                    <span>Jobs@(_jobs > 0 ? $" ({_jobs})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="recycle" @onclick="Close">
                    <i class="bi bi-recycle"></i>
                    <span>Recycle@(_recycled > 0 ? $" ({_recycled})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="logs" @onclick="Close">
                    <i class="bi bi-journal-text"></i>
                    <span>Logs</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="tools" @onclick="Close">
                    <i class="bi bi-tools"></i>
                    <span>Tools@(Tools.UpdateCount > 0 ? $" ({Tools.UpdateCount})" : "")</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="settings" @onclick="Close">
                    <i class="bi bi-gear"></i>
                    <span>Settings@(_warnings > 0 ? $" ({_warnings})" : "")</span>
                </NavLink>
            </li>
        </ul>
    </div>

    <div class="sv-sidebar-footer">
        <ul class="nav flex-column w-100">
            <li class="nav-item">
                <button class="nav-link w-100" onclick="scratcharrTheme.toggle()">
                    <i class="bi bi-circle-half"></i>
                    <span>Light / dark</span>
                </button>
            </li>
        </ul>
        <div class="d-flex align-items-center justify-content-between sv-footer-meta">
            <span class="d-flex align-items-center gap-2">
                <ConnectionLight/>
                <a href="https://github.com/yannb2/scratcharr" target="_blank" rel="noopener"
                   class="sv-version text-decoration-none">v@(AppInfo.Version)</a>
            </span>
            <button class="btn btn-link text-light p-0 sv-footer-btn d-none d-md-inline-flex"
                    @onclick="() => _collapsed = !_collapsed"
                    title="@(_collapsed ? "Expand" : "Collapse")">
                <i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
            </button>
        </div>
    </div>
</nav>

@if (MobileOpen)
{
    <div class="sv-sidebar-backdrop d-md-none" @onclick="Close"></div>
}

@code {
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback<bool> MobileOpenChanged { get; set; }

    private bool _collapsed;
    private int _review;
    private int _warnings;
    private int _archives;
    private int _jobs;
    private int _recycled;

    protected override void OnInitialized()
    {
        Count();
        Scans.Changed += OnChanged;
        Tools.Changed += OnChanged;
        Queue.Changed += OnChanged;
        Cleaner.Changed += OnChanged;
    }

    private void Count()
    {
        var last = Scans.Last;
        _review = last?.Items.Count(i => i.Verdict.NeedsReview()) ?? 0;
        _warnings = last?.Settings.Findings.Count(f => f.Severity == Severity.Warning) ?? 0;
        _archives = last?.Items.Count(i => Jobs.UnpackPlan.Offers(i.Item)) ?? 0;
        _jobs = Queue.OpenCount;
        _recycled = Cleaner.Recycled().Count;
    }

    private void OnChanged()
    {
        InvokeAsync(() =>
        {
            Count();
            StateHasChanged();
        });
    }

    private async Task Close()
    {
        if (MobileOpen)
        {
            await MobileOpenChanged.InvokeAsync(false);
        }
    }

    public void Dispose()
    {
        Scans.Changed -= OnChanged;
        Tools.Changed -= OnChanged;
        Queue.Changed -= OnChanged;
        Cleaner.Changed -= OnChanged;
    }
}
