@page "/logs"
@implements IDisposable
@inject MemoryLog Log

<PageTitle>Logs · Scratcharr</PageTitle>

<div class="d-flex align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0 me-auto">Logs</h2>
    <button class="btn btn-sm btn-outline-danger" @onclick="Log.Clear"><i class="bi bi-trash me-1"></i>Clear</button>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <input class="form-control form-control-sm" style="max-width: 20rem" placeholder="Search message or source"
           @bind="_search" @bind:event="oninput"/>
    <div class="btn-group btn-group-sm" role="group" aria-label="Level">
        @foreach (var (key, label) in Levels)
        {
            <button type="button" class="btn @(_level == key ? "btn-primary" : "btn-outline-primary")" @onclick="() => _level = key">@label</button>
        }
    </div>
    <span class="small text-body-secondary ms-md-auto">
        The last @MemoryLog.Capacity lines since the app started, newest first (<code>docker logs</code> has them all).
    </span>
</div>

@{
    var shown = Shown.ToList();
}
@if (shown.Count == 0)
{
    <div class="alert alert-secondary">Nothing to show.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 small">
                <thead>
                <tr>
                    <th style="width: 9rem">Time</th>
                    <th style="width: 4rem">Level</th>
                    <th style="width: 12rem">Source</th>
                    <th>Message</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var line in shown.Take(_limit))
                {
                    <tr class="@RowClass(line.Level)">
                        <td class="text-nowrap font-monospace">@line.Time.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                        <td><span class="badge @Badge(line.Level)">@Short(line.Level)</span></td>
                        <td class="text-truncate" style="max-width: 12rem" title="@line.Source">@MemoryLog.ShortSource(line.Source)</td>
                        <td class="sv-log-message">
                            @line.Message
                            @if (line.Exception != null)
                            {
                                <div>
                                    <button class="btn btn-sm btn-link p-0" @onclick="() => Toggle(line.Id)">
                                        <i class="bi @(_open.Contains(line.Id) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>Exception
                                    </button>
                                </div>
                                @if (_open.Contains(line.Id))
                                {
                                    <pre class="small mb-0 mt-1 p-2 rounded bg-body-tertiary sv-log-exception">@line.Exception</pre>
                                }
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @if (shown.Count > _limit)
    {
        <button class="btn btn-sm btn-link mt-2" @onclick="() => _limit += 200">Show 200 more (@(shown.Count - _limit) left)</button>
    }
}

@code {
    private static readonly (string Key, string Label)[] Levels = [("all", "All"), ("info", "Info"), ("warning", "Warnings"), ("error", "Errors")];

    private string _search = "";
    private string _level = "all";
    private int _limit = 200;
    private readonly HashSet<long> _open = [];
    private List<LogLine> _lines = [];
    private DateTime _lastRefresh = DateTime.MinValue;
    private bool _refreshQueued;

    protected override void OnInitialized()
    {
        _lines = Log.Lines();
        Log.Changed += OnChanged;
    }

    /// <summary>Lines at the picked level and above that contain the search text.</summary>
    private IEnumerable<LogLine> Shown => _lines.Where(l => _level switch
        {
            "info" => l.Level >= LogLevel.Information,
            "warning" => l.Level >= LogLevel.Warning,
            "error" => l.Level >= LogLevel.Error,
            _ => true
        })
        .Where(l => _search.Length == 0 || l.Message.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                        || l.Source.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void OnChanged()
    {
        // Lines can come in bursts: refresh at most once a second.
        if (_refreshQueued)
        {
            return;
        }

        _refreshQueued = true;
        var wait = TimeSpan.FromSeconds(1) - (DateTime.UtcNow - _lastRefresh);
        _ = Task.Delay(wait > TimeSpan.Zero ? wait : TimeSpan.Zero).ContinueWith(_ => InvokeAsync(() =>
        {
            _refreshQueued = false;
            _lastRefresh = DateTime.UtcNow;
            _lines = Log.Lines();
            StateHasChanged();
        }));
    }

    private void Toggle(long id)
    {
        if (!_open.Remove(id))
        {
            _open.Add(id);
        }
    }

    private static string Short(LogLevel level) => level switch
    {
        LogLevel.Trace => "TRC",
        LogLevel.Debug => "DBG",
        LogLevel.Information => "INF",
        LogLevel.Warning => "WRN",
        LogLevel.Error => "ERR",
        LogLevel.Critical => "CRT",
        _ => level.ToString()
    };

    private static string Badge(LogLevel level) => level switch
    {
        LogLevel.Warning => "text-bg-warning",
        LogLevel.Error or LogLevel.Critical => "text-bg-danger",
        LogLevel.Information => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private static string RowClass(LogLevel level) => level switch
    {
        LogLevel.Warning => "table-warning",
        LogLevel.Error or LogLevel.Critical => "table-danger",
        _ => ""
    };

    public void Dispose() => Log.Changed -= OnChanged;
}
