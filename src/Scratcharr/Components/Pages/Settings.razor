@page "/settings"
@page "/settings/{Tab}"
@page "/check"
@implements IDisposable
@inject ScanService Scans
@inject NavigationManager Nav

<PageTitle>Settings · Scratcharr</PageTitle>

<h2 class="border-bottom pb-3 mb-3"><i class="bi bi-gear me-2"></i>Settings</h2>

<ul class="nav nav-tabs mb-3">
    @foreach (var (key, label, icon) in Tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(_tab == key ? "active" : "")" href="settings/@key">
                <i class="bi @icon me-1"></i>@label
                @if (key == "check" && _warnings > 0)
                {
                    <span class="badge text-bg-warning ms-1">@_warnings</span>
                }
            </a>
        </li>
    }
</ul>

@if (_tab == "check")
{
    <CheckTab/>
}
else if (_tab == "protected")
{
    <ProtectedTab/>
}
else if (_tab == "status")
{
    <StatusTab/>
}
else
{
    <IntegrationsTab/>
}

@code {
    [Parameter] public string? Tab { get; set; }

    private string _tab = "integrations";

    public static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("integrations", "Integrations", "bi-plug"),
        ("check", "Settings check", "bi-clipboard-check"),
        ("protected", "Protected folders", "bi-shield-lock"),
        ("status", "Status", "bi-info-circle")
    ];

    private int _warnings;

    protected override void OnInitialized()
    {
        Scans.Changed += OnScanned;
        Count();
    }

    // The old /check address (bookmarks) opens the Settings check tab.
    protected override void OnParametersSet() =>
        _tab = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0] == "check" ? "check"
            : Tabs.Any(t => t.Key == Tab) ? Tab! : "integrations";

    private void Count() =>
        _warnings = Scans.Last?.Settings.Findings.Count(f => f.Severity == Severity.Warning) ?? 0;

    private void OnScanned() => InvokeAsync(() =>
    {
        Count();
        StateHasChanged();
    });

    public void Dispose() => Scans.Changed -= OnScanned;
}
