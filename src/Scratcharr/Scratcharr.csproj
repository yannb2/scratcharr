<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.4.0</Version>
        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- The SDK only adds blazor.web.js when it sees .razor files at restore time.
             The Dockerfile restores from the .csproj alone, so say it here. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Scratcharr.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared with Ripparr and Muxarr. A git submodule, see README. -->
        <ProjectReference Include="..\..\arrkit\src\Arrkit\Arrkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Settings and first-seen times, in /config. -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
    </ItemGroup>

</Project>
